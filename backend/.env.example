# =============================================================================
# Stellar-MicroPay — Backend API environment variables
# Copy this file to `backend/.env` and adjust the values for your environment.
# Production requires JWT_SECRET, SERVER_PRIVATE_KEY, and PAYMENT_SIGNING_SECRET.
# Everything else is optional or has a default; see the root ENV.md inventory.
# =============================================================================

# Port the Express API listens on. (Optional — defaults to 4000)
PORT=4000

# Runtime mode: "development" | "production" | "test". (Optional — defaults to development)
NODE_ENV=development

# Stellar network to talk to: "testnet" | "mainnet". (Optional — defaults to testnet)
STELLAR_NETWORK=testnet

# URL of the Stellar Horizon instance used for account + transaction lookups.
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
# (Optional — defaults to the Horizon URL for STELLAR_NETWORK)
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint used by contract reads and event streams.
# (Optional — defaults to the RPC URL for STELLAR_NETWORK)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# MicroPay contract ID used by event streaming. Optional; streams report unconfigured.
CONTRACT_ID=

# Comma-separated list of browser origins allowed to call the API (CORS).
# Add your frontend origin(s) here, e.g. https://app.example.com
# (Optional — defaults to http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@stellarmicropay.com

# Turrets signer address funded by users for scheduled transactions.
# If empty, the server generates an ephemeral signer at startup.
TURRETS_SIGNER_ADDRESS=

# Public host domain of this deployment, used in generated links / metadata.
# (Optional — defaults to stellarmicropay.com)
DOMAIN=localhost

# SEP-10 home domain served in the stellar.toml / challenge transaction.
# (Optional — defaults to DOMAIN, then localhost:4000)
HOME_DOMAIN=localhost

# Secret used to sign and verify SEP-10 session JWTs (HS256).
# REQUIRED in production. Local development uses a test-only fallback.
# Never commit the real value to version control.
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_base64_32

# Secret used to sign X-Timestamp / X-Signature headers on POST /api/payments/submit.
# REQUIRED in production. Never commit the real value to version control.
# Generate with: openssl rand -hex 32
PAYMENT_SIGNING_SECRET=your_payment_signing_secret_here_generate_with_openssl_rand_hex_32

# Stellar secret key (S...) of the backend server account, used to sign
# server-side transactions such as SEP-10 challenges.
# REQUIRED in production. Local development generates an ephemeral key.
# Keep this offline / in a secret manager — never commit it.
# Generate a keypair with: stellar keys generate --global server
SERVER_PRIVATE_KEY=your_stellar_secret_key_here_starts_with_S

# API Key for Anthropic Claude, used by the AI Payment Assistant parsing endpoint.
# Optional — if not set, the AI assistant will show a degraded-mode message.
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Port for the Stellar Turrets txFunctions sidecar server.
# (Optional — defaults to 4100)
TURRETS_PORT=4100

# How often (in milliseconds) the Turrets runner evaluates subscribed functions.
# (Optional — defaults to 30000)
TURRETS_EVALUATION_INTERVAL_MS=30000

# Redis connection for caching layer.
# (Optional — unset disables Redis and uses in-memory cache)
REDIS_URL=

# Analytics cache TTL in milliseconds (time-to-live for cached data).
# (Optional — defaults to 300000 / 5 minutes)
ANALYTICS_CACHE_TTL_MS=300000

# Analytics cache capacity when Redis is unavailable. (Optional — defaults to 500)
ANALYTICS_CACHE_MAX_ENTRIES=500

# Events polling intervals and ledger lookback. All optional and defaulted.
EVENTS_POLL_INTERVAL_MS=5000
EVENTS_HEARTBEAT_INTERVAL_MS=15000
EVENTS_LEDGER_LOOKBACK=20

# Stellar asset issuer allowlist (comma-separated). (Optional — defaults to the public USDC issuer)
USDC_ISSUER=

# File locations for local JSON stores. (Optional — default under backend/data/)
USERNAMES_DATA_FILE=
SCHEDULED_TX_DATA_FILE=
LEADERBOARD_OPTOUT_DATA_FILE=

# Optional features and operations.
ADMIN_PUBLIC_KEYS=
METRICS_ENABLED=false
LOG_LEVEL=info

# Optional override for CSRF HMAC tokens. Defaults to JWT_SECRET.
CSRF_SECRET=
